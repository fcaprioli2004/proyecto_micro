static void uart_enviar_respuesta_valor(const char *formato, uint32_t valor1, uint32_t valor2)
{
    int longitud = snprintf(mensaje_uart, sizeof(mensaje_uart), formato, (unsigned long)valor1, (unsigned long)valor2);

    if (longitud > 0)
    {
        uint16_t cantidad = (longitud < (int)sizeof(mensaje_uart)) ?  (uint16_t)longitud : (uint16_t)(sizeof(mensaje_uart) - 1U);

        HAL_UART_Transmit(&huart1, (uint8_t *)mensaje_uart, cantidad, 100U);
    }
}

static uint8_t parsear_uint32(const char *texto, uint32_t *valor)
{
    uint32_t acumulado = 0;

    if ((texto == NULL) || (valor == NULL) || (*texto == '\0'))
    {
        return 0U;
    }

    while (*texto != '\0')
    {
        uint32_t digito;

        if ((*texto < '0') || (*texto > '9'))
        {
            return 0;
        }

        digito = (uint32_t)(*texto - '0');

        if (acumulado > ((UINT32_MAX - digito) / 10U))
        {
            return 0;
        }

        acumulado = (acumulado * 10U) + digito;
        texto++;
    }

    *valor = acumulado;
    return 1;
}

//funcion para simplificar la lectura del sensor IR
static uint8_t Hay_Botella(void)
{
    return (HAL_GPIO_ReadPin(SENSOR_BOTELLA_GPIO_Port, SENSOR_BOTELLA_Pin) == GPIO_PIN_RESET) ? 1 : 0; //reset = botella detectada = 1 en este caso
}

static void iniciar_dosificacion(void) //se utiliza cuando se da :I1 local, realizamos lo mismo en case CMD_TANQUE_CONTROL_DOSIF:
{
    //uint32_t primask;

    if (estado_tanque == TANQUE_ALARMA)
    {
        uart_enviar_texto("ERROR: ALARMA_TANQUE\r\n");
        return;
    }

    if (receta_lista == 0)
    {
        uart_enviar_texto("ERROR: SIN_RECETA\r\n");
        return;
    }

    if ((estado_dosi == DOSIF_LLENANDO) || (estado_dosi == DOSIF_ESPERANDO_BOTELLA))
    {
        uart_enviar_texto("ERROR: DOSIFICACION_ACTIVA\r\n");
        return;
    }

    if ((estado_dosi == DOSIF_BOTELLA_LLENA) && (Hay_Botella() != 0))
    {
        uart_enviar_texto("ERROR: RETIRE_BOTELLA_ANTERIOR\r\n");
        return;
    }

    if (evento_llenado_pendiente != 0)
    {
        uart_enviar_texto("ERROR: EVENTO_LLENADO_SIN_CONFIRMAR\r\n");
        return;
    }

    /*primask = __get_PRIMASK();
    __disable_irq();*/

    pulsos_caudal = 0;

    /*if (primask == 0)
    {
        __enable_irq();
    }*/

    if (Hay_Botella() != 0)
    {
        estado_dosi = DOSIF_LLENANDO;
        uart_enviar_texto("OK: DOSIFICACION INICIADA\r\n");
    }
    else
    {
        estado_dosi = DOSIF_ESPERANDO_BOTELLA;
        uart_enviar_texto("OK: ESPERANDO_BOTELLA\r\n");
    }
}

