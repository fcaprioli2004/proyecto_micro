static void interpretar_comando(void) //interprete de comandos por UART local
{
    uint32_t valor;
    char comando;

    if (comando_desbordado != 0)
    {
        uart_enviar_texto("ERR,COMANDO_DEMASIADO_LARGO\r\n");
        return;
    }

    if (buffer_rx[0] == '\0')
    {
        uart_enviar_texto("ERR,COMANDO_VACIO\r\n");
        return;
    }

    comando = buffer_rx[0];
    if ((comando >= 'a') && (comando <= 'z'))
    {
        comando = (char)(comando - ('a' - 'A'));
    }

    if (parsear_uint32(&buffer_rx[1], &valor) == 0U)
    {
        uart_enviar_texto("ERR,PARAMETRO_INVALIDO\r\n");
        return;
    }

    switch (comando)
    {
        case 'S':
            if (valor > SETPOINT_MAX_CM)
            {
                uart_enviar_respuesta_valor("ERR,S,RANGO=0..%lu\r\n",SETPOINT_MAX_CM, 0U);
                return;
            }

            setpoint_nivel = (uint8_t)valor;
            uart_enviar_respuesta_valor("OK,S,%lu\r\n", valor, 0U);
            break;

        case 'R':
            if ((valor == 0U) || (valor > VOLUMEN_RECETA_MAX_ML))
            {
                uart_enviar_respuesta_valor("ERR,R,RANGO=1..%lu\r\n", VOLUMEN_RECETA_MAX_ML, 0U);
                return;
            }

            if ((estado_dosi == DOSIF_LLENANDO) || (estado_dosi == DOSIF_ESPERANDO_BOTELLA))
            {
                uart_enviar_texto("ERR,R,DOSIFICACION_ACTIVA\r\n");
                return;
            }

            volumen_receta_ml = (uint16_t)valor;
            pulsos_objetivo = ((valor * PULSOS_X100_POR_ML) + 50U) / 100U;
            receta_lista = 1U;

            uart_enviar_respuesta_valor("OK,R,ML=%lu,PULSOS=%lu\r\n", valor, pulsos_objetivo);
            break;

        case 'I':
            if (valor == 1)
            {
                iniciar_dosificacion();
            }
            else if (valor == 0)
            {
                abortar_dosificacion();
                uart_enviar_texto("OK,I,ABORTADA\r\n");
            }
            else
            {
                uart_enviar_texto("ERR,I,USE_0_O_1\r\n");
            }
            break;

        case 'A':
            if (valor == 1U)
            {
                resetear_alarma_tanque();
                uart_enviar_texto("OK,A,RESETEADA\r\n");
            }
            else
            {
                uart_enviar_texto("ERR,A,USE_1\r\n");
            }
            break;

        default:
            uart_enviar_texto("ERR,COMANDO_DESCONOCIDO\r\n");
            break;
    }
}

static uint16_t HCSR04_Get_Distance_Filtered(void) //filtro para suavizar los cambios repentinos
{
    static uint16_t muestras[5] = {0};
    static uint8_t cantidad = 0;
    static uint8_t posicion = 0;
    uint16_t distancia = HCSR04_Get_Distance();
    uint32_t suma = 0;

    if ((distancia < 2U) || (distancia > 30U)) //si esta fuera del rango no la filtra
    {
        return 0;
    }

    muestras[posicion] = distancia;
    posicion = (uint8_t)((posicion + 1) % 5); //con %5 hace que vuelva a 0 despues de 4

    if (cantidad < 5) //al encender todavia no hay 5 mediciones
    {
        cantidad++;
    }

    for (uint8_t i = 0; i < cantidad; i++)
    {
        suma += muestras[i];
    }

    return (uint16_t)(suma / cantidad);
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        char dato = (char)rx_byte;

        if ((dato == ':') && (comando_listo == 0))
        {
            recibiendo = 1;
            indice = 0;
            comando_desbordado = 0;
            buffer_rx[0] = '\0';
        }
        else if ((recibiendo != 0) && (comando_listo == 0))
        {
            if ((dato == '\n') || (dato == '\r'))
            {
                buffer_rx[indice] = '\0';
                recibiendo = 0;
                comando_listo = 1;
            }
            else if (indice < (BUFFER_SIZE - 1U))
            {
                buffer_rx[indice++] = dato;
            }
            else
            {
                comando_desbordado = 1;
            }
        }

        HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
    }
    else if (huart->Instance == USART3)
    {
        RS485_Rx_Callback(huart);
    }
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        __HAL_UART_CLEAR_OREFLAG(huart);

        recibiendo = 0U;
        indice = 0U;
        comando_desbordado = 0U;

        huart->ErrorCode = HAL_UART_ERROR_NONE;
        huart->RxState = HAL_UART_STATE_READY;
        __HAL_UNLOCK(huart);

        HAL_UART_Receive_IT(&huart1, &rx_byte, 1U);
    }
    else if (huart->Instance == USART3)
    {
        RS485_Error_Callback(huart);
    }
}


