static void resetear_alarma_tanque(void)
{
    detener_bomba_tanque();
    chequeo_seco_activo = 0;
    lecturas_invalidas = 0;
    alarma_codigo = ALARMA_SIN_ERROR;
    estado_tanque = TANQUE_AUTONOMO;

    HAL_GPIO_WritePin(LED_ALARMA_GPIO_Port, LED_ALARMA_Pin, GPIO_PIN_RESET);
}

static void maquina_estados_dosificador(void)
{
    uint8_t hay_botella = Hay_Botella();

    switch (estado_dosi)
    {
        case DOSIF_ESPERANDO_BOTELLA:
            detener_bomba_dosificador();

            if (hay_botella != 0)
            {
                estado_dosi = DOSIF_LLENANDO;
                uart_enviar_texto("OK: BOTELLA_DETECTADA, COMIENZA LLENADO\r\n");
            }
            break;

        case DOSIF_ESPERANDO_INICIO:
            detener_bomba_dosificador();
            break;

        case DOSIF_LLENANDO:
        {
            uint32_t pulsos_umbral_lento;

            if (hay_botella == 0)
            {
                abortar_dosificacion();
                uart_enviar_texto("ERROR: BOTELLA_RETIRADA\r\n");
                break;
            }

            if (pulsos_objetivo == 0) //hay receta?
            {
                abortar_dosificacion();
                uart_enviar_texto("ERROR: RECETA_INVALIDA\r\n");
                break;
            }

            pulsos_umbral_lento = (pulsos_objetivo * PORCENTAJE_CAMBIO_LENTO) / 100U;

            if (pulsos_caudal >= pulsos_objetivo) //ya llego a los pulsos objetivo?
            {
                detener_bomba_dosificador();
                estado_dosi = DOSIF_BOTELLA_LLENA;

                tanque_generar_evento_llenado();

                uart_enviar_respuesta_valor("OK,LLENADO,COMPLETO,PULSOS=%lu,ML=%lu\r\n", pulsos_caudal, volumen_receta_ml);
            }
            else //llena
            {
                HAL_GPIO_WritePin(DOSI_IN1_GPIO_Port, DOSI_IN1_Pin, GPIO_PIN_SET);
                HAL_GPIO_WritePin(DOSI_IN2_GPIO_Port, DOSI_IN2_Pin, GPIO_PIN_RESET);

                if (pulsos_caudal < pulsos_umbral_lento) //¿ya llego a los pulsos para que desacelere?
                {
                    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_3, PWM_DOSI_RAPIDO);
                }
                else
                {
                    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_3, PWM_DOSI_LENTO);
                }
            }
            break;
        }

        case DOSIF_BOTELLA_LLENA:

        	detener_bomba_dosificador();
            if (hay_botella == 0) //cuando retiramos la botella vuelve a arrancar el ciclo
            {
                estado_dosi = DOSIF_ESPERANDO_INICIO;
            }
            break;

        default:
            abortar_dosificacion();
            break;
    }
}

static void maquina_estados_tanque(void)
{
    uint16_t distancia = HCSR04_Get_Distance_Filtered();

    if ((distancia < 2U) || (distancia > ALTURA_TANQUE_CM)) //¿el nivel se sale de los limites?
    {
        detener_bomba_tanque(); //frenamos el llenado por seguridad

        if (lecturas_invalidas < UINT8_MAX)
        {
            lecturas_invalidas++;
        }

        if ((lecturas_invalidas >= LECTURAS_INVALIDAS_MAX) && (estado_tanque != TANQUE_ALARMA)) //despues de 5 mediciones malas salta la alama
        {
            disparar_alarma(ALARMA_SENSOR_NIVEL);
        }

        return;
    }

    //si la medicion es valida
    lecturas_invalidas = 0;
    distancia_tanque_cm = distancia;
    nivel_tanque_filtrado = (uint8_t)(ALTURA_TANQUE_CM - distancia_tanque_cm);

    if (estado_tanque != TANQUE_ALARMA)
    {
        if (nivel_tanque_filtrado >= NIVEL_REBOSE_CRITICO_CM)
        {
            disparar_alarma(ALARMA_REBOSE);
        }
        else if (bomba_tanque_encendida != 0)
        {
            if (chequeo_seco_activo == 0)
            {
                chequeo_seco_activo = 1;
                tick_inicio_bomba = HAL_GetTick();
                nivel_inicial_bomba = nivel_tanque_filtrado;
            }
            else if ((HAL_GetTick() - tick_inicio_bomba) >= TIEMPO_MARCHA_SECO_MS)
            {
                if (nivel_tanque_filtrado <= nivel_inicial_bomba) //si el nivel no ha aumentado, enccendemos la alarma
                {
                    disparar_alarma(ALARMA_MARCHA_SECO);
                }
                else  //si aumenta, iniciamos un nuevo periodo de comprobacion
                {
                    tick_inicio_bomba = HAL_GetTick();
                    nivel_inicial_bomba = nivel_tanque_filtrado;
                }
            }
        }
        else //si la bomba esta apagada
        {
            chequeo_seco_activo = 0;
        }
    }

    switch (estado_tanque)
    {
        case TANQUE_AUTONOMO:
        {
            int16_t error = (int16_t)setpoint_nivel - (int16_t)nivel_tanque_filtrado;

            if (error > 0)
            {
                uint8_t pwm;
                bomba_tanque_encendida = 1; //para el control de alarmas tambien

                if (error >= BANDA_PROPORCIONAL_CM)
                {
                    pwm = PWM_TANQUE_MAX;
                }
                else
                {
                    pwm = PWM_TANQUE_MIN + (uint8_t)(((PWM_TANQUE_MAX - PWM_TANQUE_MIN) * error) / BANDA_PROPORCIONAL_CM);
                }

                HAL_GPIO_WritePin(TANQUE_IN1_GPIO_Port, TANQUE_IN1_Pin, GPIO_PIN_SET);
                HAL_GPIO_WritePin(TANQUE_IN2_GPIO_Port, TANQUE_IN2_Pin, GPIO_PIN_RESET);
                __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, pwm);

            }
            else //nivel igual o superior al setpoint
            {
                detener_bomba_tanque();
            }
            break;
        }

        case TANQUE_ALARMA:
        default:
            detener_bomba_tanque();
            break;
    }
}

static void detener_bomba_tanque(void)
{
    bomba_tanque_encendida = 0; //flag de que la bomba esta apagada

    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0);

    HAL_GPIO_WritePin(TANQUE_IN1_GPIO_Port, TANQUE_IN1_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(TANQUE_IN2_GPIO_Port, TANQUE_IN2_Pin, GPIO_PIN_RESET);
}

static void detener_bomba_dosificador(void)
{
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_3, 0U);

    HAL_GPIO_WritePin(DOSI_IN1_GPIO_Port, DOSI_IN1_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(DOSI_IN2_GPIO_Port, DOSI_IN2_Pin, GPIO_PIN_RESET);
}

static void disparar_alarma(uint8_t codigo)
{
    estado_tanque = TANQUE_ALARMA;
    alarma_codigo = codigo;
    chequeo_seco_activo = 0; //no comprobamos la marcha en seco porque esta detenido

    detener_bomba_tanque();
    abortar_dosificacion();

    HAL_GPIO_WritePin(LED_ALARMA_GPIO_Port, LED_ALARMA_Pin, GPIO_PIN_SET);

    uart_enviar_respuesta_valor("ALARM,TANQUE,CODIGO=%lu\r\n", codigo, 0U);
}

