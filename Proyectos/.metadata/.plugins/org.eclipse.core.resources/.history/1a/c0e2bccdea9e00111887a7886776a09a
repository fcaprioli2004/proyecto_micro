/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  MX_USART1_UART_Init();
  MX_USART3_UART_Init();

  /* USER CODE BEGIN 2 */
  if (HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1) != HAL_OK)
  {
    Error_Handler();
  }

  if (HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3) != HAL_OK)
  {
    Error_Handler();
  }

  detener_bomba_tanque();
  detener_bomba_dosificador();

  HAL_GPIO_WritePin(LED_ALARMA_GPIO_Port, LED_ALARMA_Pin, GPIO_PIN_RESET);

  HCSR04_Init();

  if (HAL_UART_Receive_IT(&huart1, &rx_byte, 1) != HAL_OK)
  {
    Error_Handler();
  }

  if (RS485_Init(&huart3, RS485_DE_GPIO_Port, RS485_DE_Pin, ID_TANQUE) != HAL_OK)
  {
    Error_Handler();
  }

  uart_enviar_texto("Iniciando...\r\n");
  uart_enviar_texto("Comandos: :S15 :R500 :I1 :I0 :A1 (terminar con CR/LF)\r\n");

  tick_control_tanque = HAL_GetTick();
  tick_uart = HAL_GetTick();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    procesar_rs485_tanque();

    if (comando_listo != 0)
    {
      interpretar_comando();
      comando_desbordado = 0;
      comando_listo = 0;
    }

    maquina_estados_dosificador();

    if ((HAL_GetTick() - tick_control_tanque) >= CONTROL_TANQUE_PERIODO_MS)
    {
      tick_control_tanque = HAL_GetTick();
      maquina_estados_tanque();
    }

    //cada 1 segundo imprime mensaje de estado por la UART local
    if ((HAL_GetTick() - tick_uart) >= 1000)
    {
      int longitud;
      uint32_t pulsos_actuales = pulsos_caudal;

      tick_uart = HAL_GetTick();
      longitud = snprintf(mensaje_uart, sizeof(mensaje_uart), "STAT: NIVEL=%u,SP=%u,BOTELLA=%u,RECETA=%u,PULSOS=%lu/%lu,ALARMA=%u\r\n",
    		  nivel_tanque_filtrado, setpoint_nivel, Hay_Botella(), volumen_receta_ml, pulsos_actuales, pulsos_objetivo, alarma_codigo);

      HAL_UART_Transmit(&huart1, (uint8_t *)mensaje_uart, (uint16_t)longitud, 100);
    }
  }
  /* USER CODE END 3 */
}

