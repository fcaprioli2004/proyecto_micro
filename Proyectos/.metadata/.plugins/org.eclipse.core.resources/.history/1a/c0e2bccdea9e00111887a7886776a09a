static HAL_StatusTypeDef tanque_enviar_rs485(uint8_t origen, uint8_t comando, uint8_t param_h, uint8_t param_l)
{
    HAL_Delay(RS485_RESPUESTA_DELAY_MS);

    return RS485_Send_Packet(origen, comando, param_h, param_l);
}

//para mandar el ACK o NACK
static void tanque_responder_resultado(uint8_t origen, uint8_t respuesta, uint8_t comando_solicitado, uint8_t codigo)
{
    if (tanque_enviar_rs485(origen, respuesta, comando_solicitado, codigo) != HAL_OK)
    {
        uart_enviar_texto("ERR,RS485,NO_SE_PUDO_ENVIAR_RESULTADO\r\n");
    }
}

//crea el evento y lo deja pediente
static void tanque_generar_evento_llenado(void)
{
    evento_llenado_secuencia++;

    if (evento_llenado_secuencia == 0) //por si se desbrda
    {
        evento_llenado_secuencia = 1;
    }

    evento_llenado_pendiente = 1;
}

static void procesar_rs485_tanque(void)
{
    uint8_t origen; //origen de donde vino el mensaje, no el origen del esclavo
    uint8_t comando;
    uint8_t param_h;
    uint8_t param_l;
    uint16_t valor;

    if (rs485_paquete_listo == 0)
    {
        return;
    }

    origen = rs485_rx_origen;
    comando = rs485_rx_cmd;
    param_h = rs485_rx_param_h;
    param_l = rs485_rx_param_l;

    rs485_paquete_listo = 0;

    if (origen != ID_MAESTRO)
    {
        return;
    }

    valor = (uint16_t)(((uint16_t)param_h << 8U) | param_l);

    switch (comando)
    {
        case CMD_PING:
            if (tanque_enviar_rs485(origen, CMD_PONG, param_h, param_l) != HAL_OK)
            {
                uart_enviar_texto("ERR,RS485,NO_SE_PUDO_ENVIAR_PONG\r\n"); //mensaje por la UART local para corroborar
            }
            break;

        case CMD_PEDIR_ESTADO_TANQUE:
            if (tanque_enviar_rs485(origen, CMD_RESP_ESTADO_TANQUE, alarma_codigo, nivel_tanque_filtrado) != HAL_OK)
            {
                uart_enviar_texto("ERR,RS485,NO_SE_PUDO_ENVIAR_ESTADO_TANQUE\r\n");
            }
            break;

        case CMD_PEDIR_ESTADO_DOSIF:
            if (tanque_enviar_rs485(origen, CMD_RESP_ESTADO_DOSIF, (uint8_t)estado_dosi, Hay_Botella()) != HAL_OK)
            {
                uart_enviar_texto("ERR,RS485,NO_SE_PUDO_ENVIAR_ESTADO_DOSIF\r\n");
            }
            break;

        case CMD_PEDIR_EVENTO_TANQUE:

            if (evento_llenado_pendiente != 0)
            {
                if (tanque_enviar_rs485(origen, CMD_EVENTO_TANQUE_LLENADO_COMPLETO, (uint8_t)(evento_llenado_secuencia >> 8U),
                        (uint8_t)(evento_llenado_secuencia & 0xFFU)) != HAL_OK)
                {
                    uart_enviar_texto("ERR,RS485,NO_SE_PUDO_ENVIAR_EVENTO_TANQUE\r\n");
                }
            }
            else
            {
                if (tanque_enviar_rs485(origen, CMD_RESP_SIN_EVENTO, 0, 0) != HAL_OK)
                {
                    uart_enviar_texto("ERR,RS485,NO_SE_PUDO_RESPONDER_SIN_EVENTO\r\n");
                }
            }
            break;

        case CMD_TANQUE_SETPOINT:
            if (valor > SETPOINT_MAX_CM)
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_FUERA_DE_RANGO);
            }
            else
            {
                setpoint_nivel = (uint8_t)valor;
                tanque_responder_resultado(origen, CMD_RESP_ACK, comando, ACK_OK);
            }
            break;

        case CMD_TANQUE_RECETA:
            if ((valor == 0) || (valor > VOLUMEN_RECETA_MAX_ML))
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_FUERA_DE_RANGO);
            }
            else if ((estado_dosi == DOSIF_LLENANDO) || (estado_dosi == DOSIF_ESPERANDO_BOTELLA))
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_OCUPADO);
            }
            else
            {
                volumen_receta_ml = valor;
                pulsos_objetivo = (((uint32_t)valor * PULSOS_X100_POR_ML) + 50U) / 100U;
                receta_lista = 1;

                tanque_responder_resultado(origen, CMD_RESP_ACK, comando, ACK_OK);
            }
            break;

        case CMD_TANQUE_CONTROL_DOSIF:
            if ((param_h != 0) || (param_l > 1)) //este comando corresponde a :TI0 o :TI1 por eso esta condicion
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_PARAMETRO_INVALIDO);
            }
            else if (param_l == 0) //por si llega :TI0
            {
                abortar_dosificacion();
                tanque_responder_resultado(origen, CMD_RESP_ACK, comando, ACK_OK);
            }
            else if (estado_tanque == TANQUE_ALARMA) //si esta en estado de alaema NACK
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_ALARMA_ACTIVA);
            }
            else if (receta_lista == 0) //si todavia no habian mandado la receta NACK
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_SIN_RECETA);
            }
            else if ((estado_dosi == DOSIF_LLENANDO) || (estado_dosi == DOSIF_ESPERANDO_BOTELLA)) //¿Ya hay una dosificación activa?
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_OCUPADO);
            }
            else if ((estado_dosi == DOSIF_BOTELLA_LLENA) && (Hay_Botella() != 0U)) //¿Existe una botella llena todavía colocada?
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_RETIRE_BOTELLA);
            }
            else if (evento_llenado_pendiente != 0U) //hay un llenado anterior
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_OCUPADO);
            }
            else
            {
                /* uint32_t primask = __get_PRIMASK();
                __disable_irq();*/

                pulsos_caudal = 0;

                /*if (primask == 0)
                {
                    __enable_irq();
                }*/

                if (Hay_Botella() != 0)
                {
                    estado_dosi = DOSIF_LLENANDO;
                    tanque_responder_resultado(origen, CMD_RESP_ACK, comando, ACK_OK);
                }
                else
                {
                    estado_dosi = DOSIF_ESPERANDO_BOTELLA;
                    tanque_responder_resultado(origen, CMD_RESP_ACK, comando, ACK_ESPERANDO_BOTELLA);
                }
            }
            break;

        case CMD_CONFIRMAR_EVENTO_TANQUE:
        {
            uint16_t secuencia_confirmada = (uint16_t)(((uint16_t)param_h << 8U) | param_l);

            if ((evento_llenado_pendiente != 0) && (secuencia_confirmada == evento_llenado_secuencia)) //¿La secuencia confirmada es la correcta?
            {
                evento_llenado_pendiente = 0; //borra el flag
            }
            break;
        }

        case CMD_TANQUE_RESET_ALARMA:
            if ((param_h != 0) || (param_l != 1)) //solo acepta :TA1
            {
                tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_PARAMETRO_INVALIDO);
            }
            else
            {
                resetear_alarma_tanque();
                tanque_responder_resultado(origen, CMD_RESP_ACK, comando, ACK_OK);
            }
            break;

        default:
            tanque_responder_resultado(origen, CMD_RESP_NACK, comando, NACK_COMANDO_NO_SOPORTADO);
            break;
    }
}

