#include "hx711.h"

#include "gpio.h"
#include "tim.h"

#include <stdbool.h>
#include <stdint.h>

#define DT_PIN   GPIO_PIN_8
#define DT_PORT  GPIOB

#define SCK_PIN  GPIO_PIN_9
#define SCK_PORT GPIOB



int32_t tare = 0;
float calibrationFactor = 1.0f;

static void HX711_DelayUs(uint16_t delay_us)
{
    __HAL_TIM_SET_COUNTER(&htim3, 0U);

    while (__HAL_TIM_GET_COUNTER(&htim3) < delay_us)
    {
    }
}

void HX711_Init(void)
{
    HAL_TIM_Base_Start(&htim3);
    HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_SET);
    HAL_Delay(10);
    HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_RESET);
    HAL_Delay(10);

    tare = 0;
    calibrationFactor = 1.0f;
}


int32_t getHX711(void)
{
  uint32_t data = 0;
  uint32_t startTime = HAL_GetTick();
  while(HAL_GPIO_ReadPin(DT_PORT, DT_PIN) == GPIO_PIN_SET)
  {
    if(HAL_GetTick() - startTime > 200)
      return 0;
  }
  for(int8_t len=0; len<24 ; len++)
  {
    HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_SET);
    HX711_DelayUs(1);
    data = data << 1;
    HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_RESET);
    HX711_DelayUs(1);

    if(HAL_GPIO_ReadPin(DT_PORT, DT_PIN) == GPIO_PIN_SET)
      data ++;
  }

  data ^= 0x800000;
  HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_SET);
  HX711_DelayUs(1);
  HAL_GPIO_WritePin(SCK_PORT, SCK_PIN, GPIO_PIN_RESET);
  HX711_DelayUs(1);

  return data;
}

int32_t HX711_ReadAverage(uint16_t samples)
{
    int64_t total = 0;
    uint16_t validSamples = 0;

    if (samples == 0)
    {
        return 0;
    }

    for (uint16_t i = 0; i < samples; i++)
    {
        int32_t raw = getHX711();

        /*
         * Actualmente getHX711() retorna 0 cuando ocurre timeout.
         * Descartamos esa lectura.
         */
        if (raw != 0)
        {
            total += raw;
            validSamples++;
        }
    }

    if (validSamples == 0)
    {
        return 0;
    }

    return (int32_t)(total / validSamples);
}
HAL_StatusTypeDef HX711_Tare(uint16_t samples)
{
    int32_t average = HX711_ReadAverage(samples);

    if (average == 0)
    {
        return HAL_TIMEOUT;
    }
    tare = average;
    return HAL_OK;
}
HAL_StatusTypeDef HX711_Calibrate(float referenceWeightMg,uint16_t samples)
{
    int32_t average;
    int32_t referenceCounts;

    if (referenceWeightMg <= 0.0f)
    {
        return HAL_ERROR;
    }

    average = HX711_ReadAverage(samples);

    if (average == 0)
    {
        return HAL_TIMEOUT;
    }
    referenceCounts = average - tare;
    if (referenceCounts == 0)
    {
        return HAL_ERROR;
    }
    calibrationFactor = referenceWeightMg / (float)referenceCounts;
    return HAL_OK;
}
int32_t HX711_Weigh(uint16_t samples)
{
    int32_t average;
    int32_t netCounts;
    float measuredWeightMg;

    average = HX711_ReadAverage(samples);

    if (average == 0)
    {
        return 0;
    }
    netCounts = average - tare;
    measuredWeightMg = (float)netCounts * calibrationFactor;
    return (int32_t)measuredWeightMg;
}
HAL_StatusTypeDef HX711_WeighStatus(uint16_t samples,int32_t *weightMg)
{
    int32_t average;
    int32_t netCounts;
    float measuredWeightMg;
    if ((samples == 0) || (weightMg == 0))
    {
        return HAL_ERROR;
    }
    average = HX711_ReadAverage(samples);
    if (average == 0)
    {
        return HAL_TIMEOUT;
    }
    netCounts = average - tare;
    measuredWeightMg =(float)netCounts * calibrationFactor;
    *weightMg = (int32_t)measuredWeightMg;
    return HAL_OK;
}
static HAL_StatusTypeDef HX711_ReadRawNonBlocking(int32_t *raw)
{
    uint32_t data = 0;

    if (raw == NULL)
    {
        return HAL_ERROR;
    }
    if (HAL_GPIO_ReadPin(DT_PORT,DT_PIN) == GPIO_PIN_SET)
    {
        return HAL_BUSY;
    }
    for (uint8_t i = 0; i < 24; i++)
    {
        HAL_GPIO_WritePin(SCK_PORT,SCK_PIN,GPIO_PIN_SET);

        HX711_DelayUs(1);

        data <<= 1;

        if (HAL_GPIO_ReadPin(DT_PORT,DT_PIN) == GPIO_PIN_SET)
        {
            data++;
        }

        HAL_GPIO_WritePin(SCK_PORT,SCK_PIN,GPIO_PIN_RESET);

        HX711_DelayUs(1);
    }

   //Pulso número 25:canal A, ganancia 128.
    HAL_GPIO_WritePin(SCK_PORT,SCK_PIN,GPIO_PIN_SET);
    HX711_DelayUs(1);
    HAL_GPIO_WritePin(SCK_PORT, SCK_PIN,GPIO_PIN_RESET);
    HX711_DelayUs(1);

    data ^= 0x800000;
    *raw = (int32_t)data;
    return HAL_OK;
}
HAL_StatusTypeDef HX711_WeighNonBlocking(int32_t *weightMg)
{
    static uint8_t esperando_dato = 0;
    static uint32_t inicio_espera = 0;

    int32_t raw;
    int32_t netCounts;

    HAL_StatusTypeDef estado;

    if (weightMg == NULL)
    {
        return HAL_ERROR;
    }

    estado = HX711_ReadRawNonBlocking(&raw);

    if (estado == HAL_BUSY)
    {
        if (esperando_dato == 0)
        {
            esperando_dato = 1;
            inicio_espera = HAL_GetTick();
        }
        if ((HAL_GetTick() - inicio_espera) >= 500U)
        {
            esperando_dato = 0;
            return HAL_TIMEOUT;
        }

        return HAL_BUSY;
    }

    esperando_dato = 0;

    if (estado != HAL_OK)
    {
        return estado;
    }

    netCounts = raw - tare;

    *weightMg = (int32_t)((float)netCounts * calibrationFactor);

    return HAL_OK;
}
